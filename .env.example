DATABASE_URL=postgresql://user:password@localhost:5432/wbdb
SYNC_HOUR=3
# Автозагрузка данных по расписанию (true/false). false — загрузка по расписанию не выполняется.
SCHEDULER_ENABLED=false
# Отчёт реализации (finance-api): размер страницы и предел ожидания при 429
SALES_REPORT_LIMIT=100000
SALES_REPORT_MAX_RETRY_WAIT=300
# Базовый URL финансового API WB (отчёт реализации, категория токена «Финансы»)
# WB_FINANCE_BASE=https://finance-api.wildberries.ru
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
